{
  "app-id": "org.cockpit_project.CockpitClient",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "cockpit-client",
  "rename-icon": "cockpit-client",
  "finish-args": [
    "--talk-name=org.freedesktop.Flatpak",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc"
  ],
  "modules": [
    {
      "name": "cockpit-client",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-cockpit-client",
        "--with-systemdunitdir=/invalid",
        "CPPFLAGS=-Itools/mock-build-env",
        "--with-admin-group=root",
        "--disable-doc"
      ],
      "make-args": [
        "build-for-flatpak"
      ],
      "make-install-args": [
        "DOWNSTREAM_RELEASES_XML=org.cockpit_project.CockpitClient.releases.xml"
      ],
      "install-rule": "install-for-flatpak",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/cockpit-project/cockpit/releases/download/367/cockpit-367.tar.xz",
          "sha256": "b29cb94ed43469196707c7f2100487fb71649a46767f8ccb1210356e0a9dd042"
        },
        {
          "type": "file",
          "path": "org.cockpit_project.CockpitClient.releases.xml"
        }
      ]
    },
    {
      "name": "cockpit-files",
      "buildsystem": "simple",
      "build-commands": [
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/cockpit-project/cockpit-files/releases/download/44/cockpit-files-44.tar.xz",
          "sha256": "47c6a2cca4d3398ea8e845963f80460201d4d7e94ac19e7e64410d760ef4e39b"
        }
      ]
    },
    {
      "name": "cockpit-machines",
      "buildsystem": "simple",
      "build-commands": [
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/cockpit-project/cockpit-machines/releases/download/356/cockpit-machines-356.tar.xz",
          "sha256": "9a8afda8b784222b55996e321f92a2038f0880219c365138dfa9b265afd6c8b1"
        }
      ]
    },
    {
      "name": "cockpit-ostree",
      "buildsystem": "simple",
      "build-commands": [
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/cockpit-project/cockpit-ostree/releases/download/226/cockpit-ostree-226.tar.xz",
          "sha256": "794d7c8d80f0cf88c3028c0f0eb374a2c2ad318364a96c563f01e2b537a8f824"
        }
      ]
    },
    {
      "name": "cockpit-podman",
      "buildsystem": "simple",
      "build-commands": [
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/cockpit-project/cockpit-podman/releases/download/130/cockpit-podman-130.tar.xz",
          "sha256": "897a9dd9e845e19a7909c7f27f0c8966c5ff6a1b3962d71aecd0365f25b1a24f"
        }
      ]
    }
  ]
}
